        "amount": -3200
      },
      {
        "registrator_title": "Приходный ордер",
        "period": "2026-04-12",
        "budgetitem_title": "Аванс от клиента",
        "номер_заказа": "234-OB",
        "номер_заказа_title": "234-OB",
        "комментарий": "Поступление по договору",
        "коммент_директор": "",
        "amount": 18600
      }
    ]
  }
}
